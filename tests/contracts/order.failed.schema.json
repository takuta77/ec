{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["event_id", "event_type", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "order.failed"},
    "data": {
      "type": "object",
      "required": ["checkout_request_id", "reason"],
      "properties": {
        "checkout_request_id": {"type": "string", "format": "uuid"},
        "reason": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
